# Template only. Store real values locally in .env or .env.neon.local; never commit.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# Copy from Neon Connect. Never use a VITE_ variable for this value.
# require is upgraded to verify-full by the server; certificates are verified.
DATABASE_URL=postgresql://USER:REPLACE_LOCALLY@HOST.neon.tech/neondb?sslmode=verify-full&channel_binding=require
RESEARCH_PROJECT_ID=tomas
TELEMETRY_MODE=off
# Render terminates HTTPS at its reverse proxy.
TRUST_PROXY=1
# Development only, ignored when DATABASE_URL is configured:
# DEV_DATABASE_PATH=runtime/dev-postgres
